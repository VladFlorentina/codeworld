# ─────────────────────────────────────────────────────────────
# CodeWorld — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=codeworld
POSTGRES_PASSWORD=codeworld
POSTGRES_DB=codeworld

# ── Application ───────────────────────────────────────────────
# Generate a strong random string for production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

ENVIRONMENT=development

# ── Worker limits ─────────────────────────────────────────────
# Maximum repository size to accept for analysis (in MB)
MAX_REPO_SIZE_MB=500

# Maximum time in seconds allowed for a single analysis job
ANALYSIS_TIMEOUT_SECONDS=300

# ── Phase 5 (GitHub App & Auth) ──────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_HOST_PATH=D:/codeworld-secrets/codeworld-dev-vlad.pem
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_private_key.pem
GITHUB_APP_SLUG=
TOKEN_ENCRYPTION_KEY=

# ── Phase 8+ (AI Architect) — Leave empty until Phase 8 ───────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
